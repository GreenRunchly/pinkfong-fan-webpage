DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always let Google's sitemap and robots files be served as real static files.
  RewriteRule ^(?:sitemap\.xml|sitemap\.txt|robots\.txt)$ - [L]

  # Legacy Indonesian path now lives at the root.
  RewriteRule ^id/?$ https://pinkfong.my.id/ [R=301,L]
</IfModule>

<IfModule mod_mime.c>
  AddType application/xml .xml
  AddType text/plain .txt
  AddType image/webp .webp
  AddCharset UTF-8 .xml
  AddCharset UTF-8 .txt
</IfModule>

<IfModule mod_headers.c>
  <Files "sitemap.xml">
    Header set Content-Type "application/xml; charset=UTF-8"
    Header set Cache-Control "public, max-age=3600"
  </Files>
  <Files "robots.txt">
    Header set Content-Type "text/plain; charset=UTF-8"
  </Files>
</IfModule>
